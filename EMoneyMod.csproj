<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>EMoneyMod</AssemblyName>
    <RootNamespace>EMoneyMod</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GameDir Condition="'$(GameDir)' == '' and '$(SDEZ_PACKAGE_DIR)' != ''">$(SDEZ_PACKAGE_DIR)</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">H:\SDEZ1.70\Package</GameDir>
  </PropertyGroup>
  <ItemGroup>
    <!-- HidSharp 不再走 NuGet: 改成引用本地副本, 并把它作为嵌入资源打进 EMoneyMod.dll,
         这样 Mods 目录里只需要一个 EMoneyMod.dll。 -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="HidSharp">
      <HintPath>libs\HidSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="libs\HidSharp.dll">
      <LogicalName>EMoneyMod.Embedded.HidSharp.dll</LogicalName>
      <Visible>false</Visible>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="MelonLoader"><HintPath>$(GameDir)\MelonLoader\net35\MelonLoader.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(GameDir)\MelonLoader\net35\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(GameDir)\Sinmai_Data\Managed\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AMDaemon.NET"><HintPath>$(GameDir)\Sinmai_Data\Managed\AMDaemon.NET.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(GameDir)\Sinmai_Data\Managed\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameDir)\Sinmai_Data\Managed\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(GameDir)\Sinmai_Data\Managed\UnityEngine.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
